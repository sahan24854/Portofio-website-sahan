---
import { sitePath } from '../lib/paths';
import "../styles/global.css";
import SEO from "../components/SEO.astro";
import ScrollExperience from "../components/ScrollExperience.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import PortfolioChat from "../components/PortfolioChat.astro";
import AmbientBackground from "../components/AmbientBackground.astro";

interface Props {
    title?: string;
    description?: string;
    image?: string;
    type?: "website" | "article";
    publishedDate?: Date;
    tags?: string[];
    canonical?: string;
}

const {
    title = "Sahan Dissanayake | Engineering Graduate · AI/ML & Telecom",
    description = "Recent BSc (Hons) Electrical and Electronic Engineering graduate interested in AI/ML and telecommunications engineering.",
    image,
    type,
    publishedDate,
    tags,
    canonical,
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="theme-color" content="#f8f7f3" />
        <script is:inline>
            (() => {
                let theme;
                try { theme = localStorage.getItem('portfolio-theme'); } catch {}
                if (theme !== 'light' && theme !== 'dark') theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                document.documentElement.dataset.theme = theme;
                document.documentElement.style.colorScheme = theme;
            })();
        </script>
        <link rel="icon" type="image/svg+xml" href={sitePath('/favicon.svg')} />
        <link rel="manifest" href={sitePath('/site.webmanifest')} />
        <meta name="generator" content={Astro.generator} />
        <link rel="preconnect" href="https://api.fontshare.com" />
        <link
            href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&f[]=satoshi@300,400,500,700&display=swap"
            rel="stylesheet"
        />
        <SEO
            title={title}
            description={description}
            image={image}
            type={type}
            publishedDate={publishedDate}
            tags={tags}
            canonical={canonical}
        />
    </head>
    <body id="page-top" class="bg-black">
        <a class="skip-link" href="#main-content">Skip to content</a>
        <AmbientBackground />
        <ScrollExperience />
        <ThemeToggle />
        <PortfolioChat />
        <main id="main-content" tabindex="-1"><slot /></main>
        <footer class="site-footer">
            <div class="section-container">
                <div class="footer-top"><p>Learning, building, and growing<br />as an engineer.</p><a href="#page-top">Back to top ↑</a></div>
                <p class="footer-name">Sahan<span> D.</span></p>
                <div class="footer-bottom"><span>© {new Date().getFullYear()} Sahan Dissanayake</span><div><a href="https://github.com/sahan24854" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="https://www.linkedin.com/in/sahan--dissanayake/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></div></div>
            </div>
        </footer>
    </body>
</html>
