---
import { sitePath } from '../lib/paths';
---
<div class="scroll-visual" data-scroll-scene>
 <div class="scroll-visual-copy" data-reveal><p class="section-kicker">Learning through real projects</p><h3>From raw inputs<br />to something useful.</h3><p>Exploring the connection between data, models, and engineering decisions — one project at a time.</p><a href={sitePath('/works/network-coverage-changes')}>Explore the network project <span aria-hidden="true">↗</span></a></div>
 <div class="scene-stage" aria-label="Illustration of data flowing into a model and then into engineering insights">
  <div class="scene-orbit" aria-hidden="true"></div>
  <div class="scene-tile scene-data" data-reveal><div class="scene-surface"><span>01 / INPUTS</span><svg viewBox="0 0 180 70" fill="none" aria-hidden="true"><path d="M5 40h22l10-16 13 33 15-52 13 40h21l12-19 14 29 13-39 12 24h25" /></svg><strong>Data &amp; observations</strong></div></div>
  <div class="scene-tile scene-model" data-reveal><div class="scene-surface"><span>02 / LEARNING</span><svg viewBox="0 0 180 70" fill="none" aria-hidden="true"><path d="M30 15l60 20 60-20M30 55l60-20 60 20M30 15v40M150 15v40"/><g><circle cx="30" cy="15" r="5"/><circle cx="30" cy="55" r="5"/><circle cx="90" cy="35" r="7"/><circle cx="150" cy="15" r="5"/><circle cx="150" cy="55" r="5"/></g></svg><strong>Models &amp; experiments</strong></div></div>
  <div class="scene-tile scene-insight" data-reveal><div class="scene-surface"><span>03 / UNDERSTANDING</span><div class="scene-bars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div><strong>Insights &amp; decisions</strong></div></div>
 </div>
</div>
