---
import { sitePath } from '../lib/paths';

---

<nav
    class="flex items-center gap-1.5 bg-[#1c1c1c]/85 backdrop-blur-xl border border-white/10 rounded-full px-3 py-2.5 shadow-2xl"
    aria-label="Main navigation"
>
    <a href={sitePath('/')} title="Home" aria-label="Home" class="dock-btn">
        <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
        >
            <path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5z"
            ></path>
            <path d="M9 21V12h6v9"></path>
        </svg>
    </a>

    <a href={sitePath('/#about')} title="About" aria-label="About" class="dock-btn">
        <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
        >
            <path d="M12 20h9"></path>
            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"
            ></path>
        </svg>
    </a>

    <a href={sitePath('/works')} title="Portfolio" aria-label="Portfolio" class="dock-btn">
        <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
        >
            <rect x="3" y="3" width="7" height="7" rx="1"></rect>
            <rect x="14" y="3" width="7" height="7" rx="1"></rect>
            <rect x="3" y="14" width="7" height="7" rx="1"></rect>
            <rect x="14" y="14" width="7" height="7" rx="1"></rect>
        </svg>
    </a>

    <span class="w-px h-5 bg-white/15 mx-0.5"></span>

    <a href={sitePath('/skills')} title="Skills" aria-label="Skills" class="dock-btn">
        <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
        >
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
    </a>

    <a
        href="https://github.com/sahan24854"
        target="_blank"
        rel="noopener noreferrer"
        title="GitHub" aria-label="GitHub"
        class="dock-btn"
    >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path
                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"
            ></path>
        </svg>
    </a>

    <a
        href="https://www.linkedin.com/in/sahan--dissanayake/"
        target="_blank"
        rel="noopener noreferrer"
        title="LinkedIn" aria-label="LinkedIn"
        class="dock-btn"
    >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M5 3a2 2 0 1 1 0 4 2 2 0 0 1 0-4ZM3 9h4v12H3V9Zm6 0h4v1.6c.6-1 1.7-1.9 3.5-1.9 3.7 0 4.5 2.4 4.5 5.5V21h-4v-6c0-1.4 0-3.1-1.9-3.1s-2.1 1.5-2.1 3V21H9V9Z" /></svg>
    </a>
</nav>

<style>
    .dock-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 9999px;
        color: rgba(255, 255, 255, 0.55);
        transition:
            background-color 0.15s,
            color 0.15s,
            transform 0.15s;
    }
    .dock-btn:hover {
        background-color: rgba(255, 255, 255, 0.1);
        color: rgba(255, 255, 255, 0.9);
        transform: translateY(-2px);
    }
</style>
