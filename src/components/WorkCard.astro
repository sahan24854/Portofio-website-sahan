---
import { sitePath } from '../lib/paths';
import type { Work } from '../lib/works';

interface Props {
  work: Work;
}

const { work } = Astro.props;
const { title, bg, cover, icon } = work.data;
---

<a href={sitePath(`/works/${work.id}`)} class="group block project-card" data-reveal data-tilt>
  <!-- Card image area -->
  <div class={`relative rounded-2xl overflow-hidden aspect-16/10 ${bg} flex items-center justify-center`}>
    <span class="project-open" aria-hidden="true">View project ↗</span>
    {cover ? (
      <img
        src={sitePath(cover)}
        alt={title}
        loading="lazy"
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    ) : icon ? (
      <div
        class="transition-transform duration-300 group-hover:scale-110"
        set:html={icon}
      />
    ) : (
      <div class="w-full h-full" />
    )}
  </div>

  <div class="project-tags">{work.data.tags.slice(0, 3).map((tag) => <span>{tag}</span>)}</div>
  <!-- Card label -->
  <div class="flex items-center gap-2.5 mt-3 px-1">
    <span class="w-6 h-6 rounded-full border border-[#ccc] theme-muted flex items-center justify-center text-xs shrink-0 transition-colors duration-200 group-hover:bg-[#0a0a0a] group-hover:text-white group-hover:border-[#0a0a0a]">
      ↗
    </span>
    <span class="theme-text text-lg font-medium">{title}</span>
  </div>
  <p class="theme-muted text-sm leading-relaxed mt-2 px-1">{work.data.description}</p>
</a>
