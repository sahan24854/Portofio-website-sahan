---
import { sitePath } from '../lib/paths';
---

<section id="contact" class="theme-surface px-8 md:px-16 pt-20 md:pt-28 pb-16">
    <div class="max-w-7xl mx-auto">
        <p class="section-kicker" data-reveal>04 / Get in touch</p>
        <!-- Label -->
        <p class="theme-muted text-xs mb-4 font-mono">That's all for now.</p>

        <!-- Heading -->
        <h2 data-reveal
            class="theme-text text-5xl md:text-7xl font-bold leading-tight mb-16 md:mb-24"
        >
            Let’s put ideas to work.<br />Let’s connect.
        </h2>

        <!-- Divider row with CTA circle -->
        <div class="relative flex items-center">
            <div class="flex-1 h-px theme-divider"></div>

            <!-- Contact CTA on the divider line -->
            <a
                href="mailto:dissanayakasahan300@gmail.com"
                class="absolute right-0 -translate-y-1/2 w-32 h-32 md:w-40 md:h-40 rounded-full bg-[#ffcf00] flex items-center justify-center text-[#111] text-sm break-all font-medium hover:bg-[#e8bd00] hover:scale-105 transition-all duration-300 shadow-lg"
                style="top: 0;"
            >
                Get in touch
            </a>

            <!-- Spacer so line extends past circle -->
            <div class="w-36 md:w-44 h-px theme-divider"></div>
        </div>

        <div class="mt-12"><a href={sitePath('/documents/Sahan_Dissanayake_CV.pdf')} download="Sahan_Dissanayake_CV.pdf" class="cv-download">Download CV <span>PDF · 275 KB</span><span aria-hidden="true">↓</span></a></div>
        <!-- Contact info -->
        <div class="flex flex-col sm:flex-row gap-8 mt-16 md:mt-20">
            <div>
                <p class="theme-muted text-xs mb-1">Email:</p>
                <a
                    href="mailto:dissanayakasahan300@gmail.com"
                    class="theme-text text-sm break-all font-medium hover:text-[#8a7000] transition-colors duration-200"
                >
                    dissanayakasahan300@gmail.com
                </a>
            </div>
            <div>
                <p class="theme-muted text-xs mb-1">Phone:</p>
                <a
                    href="tel:+94764548666"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="theme-text text-sm break-all font-medium hover:text-[#8a7000] transition-colors duration-200"
                >
                    (+94) 76 454 8666
                </a>
            </div>
        </div>
    </div>
</section>
