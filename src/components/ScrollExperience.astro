---
import { sitePath } from '../lib/paths';
const isHome = Astro.url.pathname.replace(/\/$/, '') === import.meta.env.BASE_URL.replace(/\/$/, '');
---
<div class="reading-progress" aria-hidden="true"><div data-scroll-progress></div></div>
{isHome && <nav class="scroll-nav" aria-label="Portfolio navigation" data-section-nav hidden>
  <a class="scroll-brand" href="#hero" aria-label="Back to introduction">SD<span>.</span></a>
  <div class="section-nav-links"><a href="#about">About</a><a href="#expertise">Focus</a><a href={sitePath('/skills')}>Skills</a><a href="#works">Projects</a><a href="#contact">Contact</a></div>
  <a class="nav-contact" href="mailto:dissanayakasahan300@gmail.com" aria-label="Email Sahan">Let’s talk <span aria-hidden="true">↗</span></a>
</nav>}
<a href="#page-top" class="back-to-top" aria-label="Back to top" data-back-top hidden><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m5 12 7-7 7 7M12 5v15" /></svg></a>
<script>
  const progress = document.querySelector<HTMLElement>('[data-scroll-progress]');
  const nav = document.querySelector<HTMLElement>('[data-section-nav]');
  const topLink = document.querySelector<HTMLElement>('[data-back-top]');
  const hero = document.querySelector<HTMLElement>('#hero');
  const sections = [...document.querySelectorAll<HTMLElement>('#about, #expertise, #works, #contact')];
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.section-nav-links a')];
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const scenes = [...document.querySelectorAll<HTMLElement>('[data-scroll-scene]')];
  let previousScroll = window.scrollY;
  let direction = 1;
  let scheduled = false;
  function updateScroll() {
    if (window.scrollY !== previousScroll) direction = window.scrollY > previousScroll ? 1 : -1;
    previousScroll = window.scrollY;
    if (!motion.matches) {
      for (const scene of scenes) {
        const rect = scene.getBoundingClientRect();
        if (rect.bottom < 0 || rect.top > window.innerHeight) continue;
        const position = (window.innerHeight / 2 - (rect.top + rect.height / 2)) / window.innerHeight;
        scene.style.setProperty('--scene-shift', `${Math.max(-18, Math.min(18, position * 32))}px`);
      }
    }
    const range = document.documentElement.scrollHeight - window.innerHeight;
    if (progress) progress.style.transform = `scaleX(${range > 0 ? Math.min(1, Math.max(0, window.scrollY / range)) : 0})`;
    // Keep a focused navigation control available during keyboard navigation.
    if (nav) nav.hidden = window.scrollY < (hero?.offsetHeight ?? 600) - 100 && !nav.contains(document.activeElement);
    if (topLink) topLink.hidden = window.scrollY < 600 && document.activeElement !== topLink;
    let active = '';
    for (const section of sections) {
      if (section.getBoundingClientRect().top <= window.innerHeight * .4) active = section.id;
    }
    for (const link of links) {
      if (link.hash === `#${active}`) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    }
    scheduled = false;
  }
  window.addEventListener('scroll', () => {
    if (!scheduled) { scheduled = true; requestAnimationFrame(updateScroll); }
  }, { passive: true });
  window.addEventListener('resize', updateScroll);
  new ResizeObserver(updateScroll).observe(document.body);
  updateScroll();
  const revealAnimations = new WeakMap<Element, Animation>();
  const entered = new WeakSet<Element>();
  // Animate before panels enter the visible area; never hide content on exit.
  // A child follows its parent instead of running a second, competing reveal.
  const revealTargets = [...document.querySelectorAll<HTMLElement>('[data-reveal]')]
    .filter(element => !element.parentElement?.closest('[data-reveal]'));
  if ('IntersectionObserver' in window) {
    const reveals = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) {
          entered.delete(entry.target);
          continue;
        }
        if (entered.has(entry.target)) continue;
        entered.add(entry.target);
        if (!motion.matches) {
          revealAnimations.get(entry.target)?.cancel();
          const animation = entry.target.animate(
            [{ opacity: .45, translate: `0 ${direction * 12}px` }, { opacity: 1, translate: '0 0' }],
            { duration: 700, easing: 'cubic-bezier(.22,.61,.36,1)' }
          );
          revealAnimations.set(entry.target, animation);
        }
        if (!hero) reveals.unobserve(entry.target);
      }
    }, { threshold: 0, rootMargin: '60px 0px 60px 0px' });
    revealTargets.forEach(element => reveals.observe(element));
  }
  motion.addEventListener('change', () => {
    if (!motion.matches) return;
    revealTargets.forEach(element => revealAnimations.get(element)?.cancel());
    scenes.forEach(scene => scene.style.removeProperty('--scene-shift'));
  });
  // Pointer-driven depth stays within a small angle and is disabled on touch.
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((card) => {
    let bounds: DOMRect | undefined;
    let frame = 0;
    const reset = () => {
      cancelAnimationFrame(frame);
      bounds = undefined;
      card.style.removeProperty('--tilt-x');
      card.style.removeProperty('--tilt-y');
    };
    card.addEventListener('pointerenter', () => { bounds = card.getBoundingClientRect(); });
    card.addEventListener('pointermove', (event) => {
      if (motion.matches || !finePointer.matches || !bounds) return;
      cancelAnimationFrame(frame);
      const x = Math.max(-.5, Math.min(.5, (event.clientX - bounds.left) / bounds.width - .5));
      const y = Math.max(-.5, Math.min(.5, (event.clientY - bounds.top) / bounds.height - .5));
      frame = requestAnimationFrame(() => {
        card.style.setProperty('--tilt-x', `${-y * 9}deg`);
        card.style.setProperty('--tilt-y', `${x * 9}deg`);
      });
    });
    card.addEventListener('pointerleave', reset);
    card.addEventListener('pointercancel', reset);
    motion.addEventListener('change', reset);
    finePointer.addEventListener('change', reset);
    window.addEventListener('scroll', reset, { passive: true });
  });
</script>
